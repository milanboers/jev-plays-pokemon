# TypeSafe API key — create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional: model override (defaults to jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Retry-with-backoff for the TypeSafe API (tolerates 5xx / downtime)
# TYPESAFE_MAX_RETRIES=4
# TYPESAFE_BACKOFF_INITIAL=1.0
# TYPESAFE_BACKOFF_MAX=8.0
# TYPESAFE_TIMEOUT=45.0

# Goal-sampling flattening: >1 flattens the model's goal distribution toward
# uniform (more exploration, fewer loops); <1 sharpens toward the argmax.
# GOAL_FLOOR is the minimum probability mass every offered goal keeps, so even
# a p=1.0 pick is never 100% certain.
# TYPESAFE_TEMPERATURE=2.0
# TYPESAFE_GOAL_FLOOR=0.05
